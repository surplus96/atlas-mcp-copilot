# Modified by surplus96 for atlas-mcp-copilot; notice added 2026-10-07.
# Changes: Require MCP bearer authentication and document allowed hosts.
# Based on https://github.com/GabrielGB1999/Atlas-MCP; Apache-2.0.

# Base URL of the Atlas CMMS Java API
API_BASE_URL=http://localhost:8080

# Service account used by the MCP to sign in and obtain a JWT
API_EMAIL=service-account@example.com
API_PASSWORD=change-me

# Port the MCP's HTTP transport + /health endpoint listen on
MCP_PORT=3000

# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Preemptively refresh the JWT this many minutes before it expires
JWT_EXPIRY_BUFFER_MINUTES=5

# Shared secret required as `Authorization: Bearer <token>` on the /mcp endpoint.
# REQUIRED (hardened fork) — the server refuses to start without it, even for local
# development. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Comma-separated extra Host-header values to accept on /mcp, beyond localhost and
# 127.0.0.1 (with or without :MCP_PORT). Only needed if this server is legitimately
# reached under another hostname (e.g. a docker-network service name).
ALLOWED_HOSTS=
